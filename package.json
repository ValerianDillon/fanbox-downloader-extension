{
  "name": "fanbox-downloader-extension",
  "version": "1.0.0",
  "private": true,
  "description": "pixiv FANBOX 一括ダウンロード Chrome 拡張 (Manifest V3)",
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:test": "bun scripts/build.ts --test",
    "lint": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "sh -c 'bun test \"${@:-test}\"' --",
    "test:smoke": "bun run build:test && playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValerianDillon/fanbox-downloader-extension.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ValerianDillon/fanbox-downloader-extension/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.2.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "download-helper": "github:ValerianDillon/download-helper#v10.0.0"
  }
}
