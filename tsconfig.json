{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "lib": ["dom", "es2021"],
    "types": ["chrome", "bun"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "test/**/*.ts", "e2e/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["dist/**/*", "dist-test/**/*"]
}
